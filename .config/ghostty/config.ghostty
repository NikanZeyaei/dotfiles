# Ported from kitty.conf

cursor-style = block
cursor-style-blink = true
# Keep shell integration from overriding the cursor shape
shell-integration-features = no-cursor

bell-features = no-audio
window-decoration = auto
background-opacity = 0.95

font-family = Iosevka
font-size = 14

# Colors generated by noctalia (themes/noctalia)
theme = noctalia
